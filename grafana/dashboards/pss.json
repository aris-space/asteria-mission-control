      {
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "enable": true,
        "iconColor": "red",
        "name": "State Transitions",
        "target": {
          "query": "from(bucket: \"$bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"mission_id\"] == \"$mission_id\")\n  |> filter(fn: (r) => r[\"_field\"] == \"rocket_state\")\n  |> map(fn: (r) => ({\n    r with _value: \"Transition to: [\" + r[\"_field\"] +\"]\"}))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> yield(name: \"annotations\")\n",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Actuator Transitions",
        "target": {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"valve_state\" and r._field == \"open\")\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))\n  |> difference()\n  |> filter(fn: (r) => r._value != 0)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      valve_id: r.valve_id,\n      _value: r.valve_id + (if r._value > 0 then \" opened\" else \" closed\"),\n  }))",
          "refId": "Anno"
        }
      }
    ]
  },
